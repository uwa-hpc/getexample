#!/bin/bash
#DESCRIPTION Download user examples
# Define getexample install directory 
# export GE_DIR in module file
#LABEL Files
hostid=kaya

declare -a location=("${GE_DIR}/${hostid}_examples")

N_dir=${#location[@]}

#Display help message if no example is given
if [ "$1" == "" ]; then
	printf "\nThe purpose of the this tool is to provide you with a template\n"
	printf "slurm script for a specific application with a generic model.\n"
	printf "The README file is executes a set of instructions that will \n"
	printf "submit the associated slurm script using the sbatch command and \n"
	printf "has information with more insight to the system arcitecture and \n"
	printf "links to the UWA HPC documentation! \n\n" 

	printf "usage:\n"
	printf "\t getexample <example_name> \n\n"
	
	printf "Where <example_name> is the name of the example you want to \n"
	printf "download and test.  This will download into your current \n"
	printf "the example directory which will have TWO files \n"
	printf "README file and the *.slurm file.\n\n"


	
	printf "For Example:\n"
	printf "  getexample helloworld \n\n"

	printf "will download a directory call helloworld into your current directory\n"
	printf "You then can cd into helloworld where you will find a slurm script and \n"
	printf "the README file. You simple need to run the README file/command:\n"
	printf " ./README \n\n"

	printf "Available examples on ${hostid}: \n\n"	
	
	for (( i = 1; i<${N_dir}+1;i++ ));
	do 
	    ls ${location[$i-1]}
	    echo " " 
	done
	# exit getexample here.
	exit 0
else
# they have requested an example this will create a log in their home directory.
	temp_project_id=`echo $MYGROUP | cut -d "/" -f 3`
	if [[ ! -f ${HOME}/.gehist ]]; then 
   		touch ${HOME}/.gehist 
	fi

	echo "${hostid}  $1  $USER  "$temp_project_id"  `date +%F`" >> ${HOME}/.gehist 

fi


for (( i = 1; i<${N_dir}+1;i++ ));
do 
   if [[ -d ${location[$i-1]}/$1 ]]; then
      echo found directory
# this copies the example to the users current directory
      cp -r -v -u ${location[$i-1]}/$1 .
   fi
done
