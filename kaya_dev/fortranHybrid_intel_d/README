#!/bin/bash --login
# This is the README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate hybrid_hello.f90 example
# on Kaya with Intel compiler. This is a mixed-mode job
# which includes both MPI and OpenMP.

# Copy the hybrid_hello.f90 source code
cp $GE_DIR/src/hybrid_hello.f90 .

# To run this code, we specify the total number of MPI tasks,
# the number of MPI tasks per node, and the number of threads per MPI task.
# This information is located under hello_hybrid_intel.slurm
# You can edit the SLURM script as: nano hello_hybrid_intel.slurm

# SLURM directives (set in hello_hybrid_intel.slurm):
# Here we specify to SLURM we want 2 nodes (--nodes=2),
# 8 MPI tasks (--ntasks=8), 4 MPI tasks per node (--ntasks-per-node=4),
# and 6 CPUs per task (--cpus-per-task=6).
# Load the Intel oneAPI compiler and MPI environment:
module use /uwahpc/rocky9/modulefiles/intel/2023.0
module load compiler mpi

# Inside hello_hybrid_intel.slurm, we set OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
# and launch the hybrid executable with mpirun:
# mpirun -np $SLURM_NTASKS ./$EXECUTABLE >> ${OUTPUT}

# To compile the hybrid_hello.f90 code with Intel
mpiifort -O2 -qopenmp hybrid_hello.f90 -o hello_hybrid_intel

# To submit the job to Kaya
jobid=$(sbatch --parsable hello_hybrid_intel.slurm)
echo ""
echo "The sbatch command returns what the jobid is for this job."
echo "To check the status of your job, use the slurm command:"
echo "squeue -u $USER"
echo " "
echo "Your job will be run in $MYSCRATCH/run_fortranHybrid_intel/${jobid}."
echo " "
echo "Your results will be saved in ${MYGROUP}/fortranHybrid_intel_results/${jobid}"
echo "and the scratch directory will then be deleted."
echo " "
echo "To check the results change to your jobid directory, type:"
echo "cd ${MYGROUP}/fortranHybrid_intel_results/${jobid}"
echo " " 
echo "To view the results, use the cat command and type:"
echo "cat fortranHybrid_intel.log"
echo " "
echo " Kaya user shortcuts! " 
echo  '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
echo  '$MYGROUP' "is an environment variable it is set to $MYGROUP"
echo " example:  cd \$MYGROUP "

echo " "  
echo "more information about Kaya can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs"
echo " "
echo "more information about SLURM and srun can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs/slurm"
echo " "
echo " "
