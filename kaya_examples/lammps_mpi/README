#!/bin/bash --login

# This README file is an executable script.
# To run type: ./README

# Example objective: demonstrate the LAMMPS MPI example on Kaya
# using the GNU environment.

# The simulation input files are stored in:
# $GE_DIR/src/lammps
#
# The Slurm script copies these files into the job scratch directory.
#
# Resource allocation and software modules are specified in:
# lammps_mpi_gnu.slurm

# Submit the job to Kaya.
jobid=$(sbatch --parsable lammps_mpi_gnu.slurm) || exit 1

echo " "
echo "The job has been submitted."
echo "Job ID: ${jobid}"
echo " "
echo "To check the job status, use:"
echo "squeue -u $USER"
echo " "
echo "Your job will run in:"
echo "$MYSCRATCH/run_lammps/${jobid}"
echo " "
echo "Your results will be saved in:"
echo "$MYGROUP/lmp_results/${jobid}"
echo " "
echo "To view the results, use:"
echo "cat $MYGROUP/lmp_results/${jobid}/lammps.log"
echo " "
echo "Kaya user shortcuts:"
echo '$MYSCRATCH is set to' "$MYSCRATCH"
echo '$MYGROUP is set to' "$MYGROUP"
echo " "
echo "More information about Kaya:"
echo "https://docs.hpc.uwa.edu.au/docs"
echo " "
echo "More information about Slurm:"
echo "https://docs.hpc.uwa.edu.au/docs/slurm"
echo " "
