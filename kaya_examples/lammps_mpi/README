#!/bin/bash --login

# This README file is an executable script.
# To run type: ./README

# Example objective: demonstrate the LAMMPS MPI example on Kaya
# using the GNU environment.

# The simulation input files are stored in:
# $GE_DIR/src/lammps
#
# The Slurm script copies these files into the job scratch directory.
#
# Resource allocation and software modules are specified in:
# lammps_mpi_gnu.slurm

# Submit the job to Kaya.
jobid=$(sbatch --parsable lammps_mpi_gnu.slurm) || exit 1

printf '\n'
printf '%s\n' "The job has been submitted."
printf '%s\n' "Job ID: ${jobid}"
printf '\n'
printf '%s\n' "To check the job status, use:"
printf '%s\n' "squeue -u $USER"
printf '\n'
printf '%s\n' "Your job will run in:"
printf '%s\n' "$MYSCRATCH/run_lammps/${jobid}"
printf '\n'
printf '%s\n' "Your results will be saved in:"
printf '%s\n' "$MYGROUP/lmp_results/${jobid}"
printf '\n'
printf '%s\n' "To view the results, use:"
printf '%s\n' "cat $MYGROUP/lmp_results/${jobid}/lammps.log"
printf '\n'
printf '%s\n' "Kaya user shortcuts:"
printf '%s %s\n' '$MYSCRATCH is set to' "$MYSCRATCH"
printf '%s %s\n' '$MYGROUP is set to' "$MYGROUP"
printf '\n'
printf '%s\n' "More information about Kaya:"
printf '%s\n' "https://docs.hpc.uwa.edu.au/docs"
printf '\n'
printf '%s\n' "More information about Slurm:"
printf '%s\n' "https://docs.hpc.uwa.edu.au/docs/slurm"
printf '\n'
