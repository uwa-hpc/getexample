#!/bin/bash --login
# This is the README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate hello_mpi.f90 example
# on Kaya in the GNU environment with explicit task placement.
# hello_mpi.f90 is an MPI code that binds each MPI task
# directly to a CPU core on a single node.

# Copy the hello_mpi.f90 source code
cp $GE_DIR/src/hello_mpi.f90 .

# To run this code, we specify the total number of MPI tasks
# and the number of MPI tasks per node.
# This information is located under task_placement_gnu.slurm
# You can edit the SLURM script as: nano task_placement_gnu.slurm

# SLURM directives (set in task_placement_gnu.slurm):
# Here we specify to SLURM we want 1 node (--nodes=1),
# 48 MPI tasks (--ntasks=48), and 48 tasks per node (--ntasks-per-node=48).
# Load the GNU and OpenMPI toolchain:
module load gcc/14.3.0 openmpi/5.0.5

# Inside task_placement_gnu.slurm, tasks are mapped and bound to cores with mpirun:
# mpirun -np $SLURM_NTASKS --map-by core --bind-to core ./$EXECUTABLE >> ${OUTPUT}

# To compile the hello_mpi.f90 code with GNU
mpif90 -O2 hello_mpi.f90 -o task_placement_gnu

# To submit the job to Kaya
jobid=$(sbatch --parsable task_placement_gnu.slurm)
printf '\n'
printf "%s\n" "The sbatch command returns what the jobid is for this job."
printf "%s\n" "To check the status of your job, use the slurm command:"
printf "%s\n" "squeue -u $USER"
printf '%s\n' ' '
printf "%s\n" "Your job will be run in $MYSCRATCH/run_task_placement_gnu/${jobid}."
printf '%s\n' ' '
printf "%s\n" "Your results will be saved in ${MYGROUP}/task_placement_gnu_results/${jobid}"
printf "%s\n" "and the scratch directory will then be deleted."
printf '%s\n' ' '
printf "%s\n" "To check the results change to your jobid directory, type:"
printf "%s\n" "cd ${MYGROUP}/task_placement_gnu_results/${jobid}"
printf '%s\n' ' '
printf "%s\n" "To view the results, use the cat command and type:"
printf "%s\n" "cat task_placement_gnu.log"
printf '%s\n' ' '
printf "%s\n" " Kaya user shortcuts! "
printf '%s %s\n' '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
printf '%s %s\n' '$MYGROUP' "is an environment variable it is set to $MYGROUP"
printf "%s\n" " example:  cd \$MYGROUP "

printf '%s\n' ' '
printf "%s\n" "more information about Kaya can be found at:"
printf "%s\n" " https://docs.hpc.uwa.edu.au/docs"
printf '%s\n' ' '
printf "%s\n" "more information about SLURM and srun can be found at:"
printf "%s\n" " https://docs.hpc.uwa.edu.au/docs/slurm"
printf '%s\n' ' '
printf '%s\n' ' '
