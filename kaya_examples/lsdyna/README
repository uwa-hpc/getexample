#!/bin/bash --login
# This README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate running an LS-DYNA example 
# on Kaya.

cp $GE_DIR/src/lsdyna/foam.k .

# To run this code, we need to specify the number of nodes and cores used.
# This information is located under lsdyna-foam.slurm
# You can edit the SLURM script as: nano lsdyna-foam.slurm

# SLURM directives
# Here we specify to SLURM we want 1 node (--nodes=1) and 12 tasks (--ntasks=12).
# Load the Ansys module (which includes LS-DYNA):
module load ansys/v261

# Inside lsdyna-foam.slurm, LS-DYNA is launched with:
# lsdyna i=$INPUT ncpu=${SLURM_NPROCS} > ${OUTPUT}

# To submit the job to Kaya
jobid=$(sbatch --parsable lsdyna-foam.slurm)

printf '%s\n' "The sbatch command returns what the jobid is for this job."
printf '%s\n' "To check the status of your job, use the slurm command:"
printf '%s\n' "squeue -u $USER"
printf '%s\n' " "
printf '%s\n' "Your job will be run in $MYSCRATCH/run_lsdyna_foam/${jobid}."
printf '%s\n' " "
printf '%s\n' "Your results will be saved in ${MYGROUP}/lsdyna_foam_results/${jobid}"
printf '%s\n' "and the scratch directory will then be deleted."
printf '%s\n' " "
printf '%s\n' "To check the results change to your jobid directory, type:"
printf '%s\n' "cd ${MYGROUP}/lsdyna_foam_results/${jobid}"
printf '%s\n' " "
printf '%s\n' "To view the results, use the cat command and type:"
printf '%s\n' "cat dyna_foam.log"
printf '%s\n' " "
printf '%s\n' " Kaya user shortcuts! "
printf '%s %s\n' '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
printf '%s %s\n' '$MYGROUP' "is an environment variable it is set to $MYGROUP"
printf '%s\n' " example:  cd \$MYGROUP "

printf '%s\n' " "
printf '%s\n' "more information about Kaya can be found at:"
printf '%s\n' " https://docs.hpc.uwa.edu.au/docs"
printf '%s\n' " "
printf '%s\n' "more information about SLURM and srun can be found at:"
printf '%s\n' " https://docs.hpc.uwa.edu.au/docs/slurm"
printf '%s\n' " "
printf '%s\n' " "
