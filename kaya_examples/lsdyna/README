#!/bin/bash --login
# This README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate running an LS-DYNA example 
# on Kaya.

cp $GE_DIR/src/lsdyna/foam.k .

# To run this code, we need to specify the number of nodes and cores used.
# This information is located under lsdyna-foam.slurm
# You can edit the SLURM script as: nano lsdyna-foam.slurm

# SLURM directives
# Here we specify to SLURM we want 1 node (--nodes=1) and 12 tasks (--ntasks=12).
# Load the Ansys module (which includes LS-DYNA):
module load ansys/v261

# Inside lsdyna-foam.slurm, LS-DYNA is launched with:
# lsdyna i=$INPUT ncpu=${SLURM_NPROCS} > ${OUTPUT}

# To submit the job to Kaya
jobid=$(sbatch --parsable lsdyna-foam.slurm)

echo "The sbatch command returns what the jobid is for this job."
echo "To check the status of your job, use the slurm command:"
echo "squeue -u $USER"
echo " "
echo "Your job will be run in $MYSCRATCH/run_lsdyna_foam/${jobid}."
echo " "
echo "Your results will be saved in ${MYGROUP}/lsdyna_foam_results/${jobid}"
echo "and the scratch directory will then be deleted."
echo " "
echo "To check the results change to your jobid directory, type:"
echo "cd ${MYGROUP}/lsdyna_foam_results/${jobid}"
echo " " 
echo "To view the results, use the cat command and type:"
echo "cat dyna_foam.log"
echo " "
echo " Kaya user shortcuts! " 
echo  '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
echo  '$MYGROUP' "is an environment variable it is set to $MYGROUP"
echo " example:  cd \$MYGROUP "

echo " "  
echo "more information about Kaya can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs"
echo " "
echo "more information about SLURM and srun can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs/slurm"
echo " "
echo " "
