#!/bin/bash --login
# This README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate hybrid_hello.f90 example
# in GNU environment on Kaya. This is a mixed-mode job
# which includes both MPI and OpenMP.

# Copy the hybrid_hello.f90 source code
cp $GE_DIR/src/hybrid_hello.f90 .

# To run this code, we specify the number of nodes, the total number
# of MPI tasks, and the number of OpenMP threads per MPI task.
# This information is located under hello_hybrid_gnu.slurm
# You can edit the SLURM script as: emacs hello_hybrid_gnu.slurm &

# SLURM directives (set in hello_hybrid_gnu.slurm):
# Here we specify to SLURM we want 1 node (--nodes=1),
# 6 MPI tasks (--ntasks=6), and 2 CPUs per task (--cpus-per-task=2).
# To compile the code in the GNU environment,
# we load the GNU and OpenMPI modules as shown below:
module load gcc/14.3.0 openmpi/5.0.5

# Inside the SLURM script, we set OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK}
# and launch the hybrid executable with mpirun:
# mpirun -np $SLURM_NTASKS --bind-to none -x OMP_NUM_THREADS ./${EXECUTABLE} >> ${OUTPUT}

# To compile the hybrid_hello.f90 code with GNU
mpif90 -O2 -fopenmp hybrid_hello.f90 -o hello_hybrid_gnu

# To submit the job to Kaya
jobid=$(sbatch --parsable hello_hybrid_gnu.slurm)
echo ""
echo "The sbatch command returns what the jobid is for this job."
echo "To check the status of your job, use the slurm command:"
echo "squeue -u $USER"
echo " "
echo "Your job will be run in $MYSCRATCH/run_fortranHybrid_gnu/${jobid}."
echo " "
echo "Your results will be saved in ${MYGROUP}/fortranHybrid_gnu_results/${jobid}"
echo "and the scratch directory will then be deleted."
echo " "
echo "To check the results change to your jobid directory, type:"
echo "cd ${MYGROUP}/fortranHybrid_gnu_results/${jobid}"
echo " "
echo "To view the results, use the cat command and type:"
echo "cat fortranHybrid_gnu.log"
echo " "
echo " Kaya user shortcuts! "
echo  '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
echo  '$MYGROUP' "is an environment variable it is set to $MYGROUP"
echo " example:  cd \$MYGROUP "

echo " "
echo "more information about Kaya can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs"
echo " "
echo "more information about SLURM and srun can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs/slurm"
echo " "
echo " "
