#!/bin/bash --login
# This README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate how an ABAQUS explicit job is
# run on Kaya with the SLURM job scheduler.

# Load ABAQUS to your environment
module load abaqus/2025

# Fetch the explicit model input file (e4.inp)
abaqus fetch job=e4

# To run this code, we specify the number of nodes and cores used.
# This information is located in abaqus_explicit.slurm
# You can edit the SLURM file using nano or vi:
# nano abaqus_explicit.slurm

# SLURM directives (set in abaqus_explicit.slurm):
# #SBATCH --nodes=1
# #SBATCH --ntasks=36  --> this is the number of cores/threads
# #SBATCH --mem-per-cpu=10G --> this is the amount of memory per core/thread (max is 21G)
# NOTE: If you do not specify memory, it defaults to 1GB per core.

# To submit the job to Kaya we use `sbatch abaqus_explicit.slurm`
# The --parsable flag captures the jobid number, which is useful
# for tracking jobs and check-pointing larger simulations.
jobid=$(sbatch --parsable abaqus_explicit.slurm)
printf '\n'
printf '%s\n' "The sbatch command returns what the jobid is for this job."
printf '%s\n' "To check the status of your job, use the slurm command:"
printf '%s\n' "squeue -u $USER"
printf '%s\n' " "
printf '%s\n' "Your job will be run in $MYSCRATCH/run_abaqus/${jobid}."
printf '%s\n' " "
printf '%s\n' "Your results will be saved in ${MYGROUP}/abaqus_results/${jobid}"
printf '%s\n' "and the scratch directory will then be deleted."
printf '%s\n' " "
printf '%s\n' "To check the results change to your jobid directory, type:"
printf '%s\n' "cd ${MYGROUP}/abaqus_results/${jobid}"
printf '%s\n' " "
printf '%s\n' "To view the results, use the cat command and type:"
printf '%s\n' "cat *.sta"
printf '%s\n' " "
printf '%s\n' " Kaya user shortcuts! "
printf '%s %s\n' '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
printf '%s %s\n' '$MYGROUP' "is an environment variable it is set to $MYGROUP"
printf '%s\n' " example:  cd \$MYGROUP "

printf '%s\n' " "
printf '%s\n' "more information about Kaya can be found at:"
printf '%s\n' " https://docs.hpc.uwa.edu.au/docs"
printf '%s\n' " "
printf '%s\n' "more information about SLURM and srun can be found at:"
printf '%s\n' " https://docs.hpc.uwa.edu.au/docs/slurm"
printf '%s\n' " "
printf '%s\n' " "
