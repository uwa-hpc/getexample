#!/bin/bash --login
# This README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate ORCA example on Kaya
# 
# The input file used is water.inp, taken from:
# https://faccts.de
# Copy the input file water.inp to user's directory.
cp $GE_DIR/src/orca/water.inp .

# ORCA is an MPI code that can run across multiple nodes.
# This is a simple example and needs 16 cores (MPI tasks),
# matching "%pal nprocs 16 end" inside water.inp.

# ORCA uses a specific OpenMPI library loaded automatically
# by the ORCA module once the compiler module is loaded.

# This information can be found in run_orca.slurm
# You can edit the SLURM script with nano: nano run_orca.slurm

# SLURM directives
# Here we specify in the SLURM script that we want 1 node (--nodes=1)
# and 16 MPI tasks (--ntasks=16).
# Load the GNU compiler and ORCA module:
module load gcc/14.3.0 orca/6.0.0

# To submit the job to Kaya
jobid=$(sbatch --parsable run_orca.slurm)

printf '%s\n' "The sbatch command returns what the jobid is for this job."
printf '%s\n' "To check the status of your job, use the slurm command:"
printf '%s\n' "squeue -u $USER"
printf '%s\n' " "
printf '%s\n' "Your job will be run in $MYSCRATCH/run_orca/${jobid}."
printf '%s\n' " "
printf '%s\n' "Your results will be saved in ${MYGROUP}/orca_results/${jobid}"
printf '%s\n' "and the scratch directory will then be deleted."
printf '%s\n' " "
printf '%s\n' "To check the results change to your jobid directory, type:"
printf '%s\n' "cd ${MYGROUP}/orca_results/${jobid}"
printf '%s\n' " "
printf '%s\n' "To view the results, use the cat command and type:"
printf '%s\n' "cat orca_water.out"
printf '%s\n' " "
printf '%s\n' " Kaya user shortcuts! "
printf '%s %s\n' '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
printf '%s %s\n' '$MYGROUP' "is an environment variable it is set to $MYGROUP"
printf '%s\n' " example:  cd \$MYGROUP "

printf '%s\n' " "
printf '%s\n' "more information about Kaya can be found at:"
printf '%s\n' " https://docs.hpc.uwa.edu.au/docs"
printf '%s\n' " "
printf '%s\n' "more information about SLURM and srun can be found at:"
printf '%s\n' " https://docs.hpc.uwa.edu.au/docs/slurm"
printf '%s\n' " "
printf '%s\n' " "
