#!/bin/bash --login
# This is the README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate hello_mpi.c example on Kaya
# with Intel Environment.
# hello_mpi.c code is taken from
# https://www.dartmouth.edu/~rc/classes/intro_mpi/hello_world_ex.html
# cp the hello_mpi.c source code
cp $GE_DIR/src/hello_mpi.c .


# hello_mpi.c is an MPI code that runs on 1 node 
# with 36 MPI tasks on the node.
# To run this code, we need to specify the total number of MPI tasks
# and the number of MPI tasks per node.
# This information is located under hello_mpi_intel.slurm
# You can edit the SLURM as: emacs hello_mpi_intel.slurm &

# SLURM directives
# 
# Here we specify to SLURM we want 1 node (--nodes=1)
# To compile hello_mpi.c with Intel, we load the Intel compiler and MPI:
module use /uwahpc/rocky9/modulefiles/intel/2023.0
module load compiler mpi
# To launch a job, we specify to mpirun 36 MPI tasks (-np 36)
# Therefore, the command looks like:
# mpirun -np 36 ./$EXECUTABLE >> ${OUTPUT}

# To compile the hello_mpi.c code with Intel MPI
mpiicc -O2 hello_mpi.c -o hello_mpi_intel

# To submit the job to Kaya
jobid=$(sbatch --parsable hello_mpi_intel.slurm)
echo ""
echo "The sbatch command returns what the jobid is for this job."
echo "To check the status of your job, use the slurm command:"
echo "squeue -u $USER"
echo " "
echo "Your job will be run in $MYSCRATCH/run_hello_mpi_c_intel/${jobid}."
echo " "
echo "Your results will be saved in ${MYGROUP}/hello_mpi_c_intel_results/${jobid}"
echo "and the scratch directory will then be deleted."
echo " "
echo "To check the results change to your jobid directory, type:"
echo "cd ${MYGROUP}/hello_mpi_c_intel_results/${jobid}"
echo " " 
echo "To view the results, use the cat command and type:"
echo "cat hello_mpi_c_intel.log"
echo " "
echo " Kaya user shortcuts! " 
echo  '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
echo  '$MYGROUP' "is an environment variable it is set to $MYGROUP"
echo " example:  cd \$MYGROUP "


echo " "  
echo "more information about Kaya can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs"
echo " "
echo "more information about SLURM and srun can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs/slurm"
echo " "
echo " "
