#!/bin/bash --login
# This is the README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate omp_hello.c example 
# in GNU environment on Kaya.
# omp_hello.c is an OpenMP code and restricted to a single node.
# omp_hello.c is taken from 
# https://llnl.gov
# cp the omp_hello.c source code
cp $GE_DIR/src/omp_hello.c .


# To run this code, we need to specify the number of tasks
# and the number of OpenMP threads.
# This information is located under hello_omp_gnu.slurm
# You can edit the SLURM as: emacs hello_omp_gnu.slurm &

# SLURM directives
# 
# Here we specify to SLURM we want 1 node (--nodes=1)
# To compile this code in GNU Environment, we load the GNU compilers 
# as shown below:
module load gcc/14.3
# Then, we set the total number of threads to 24 as shown below:
# export OMP_NUM_THREADS=24
# To launch a job, we specify to srun 1 OpenMP task (-n 1)
# with 24 threads (-c 24)
# Therefore, the srun command looks like:
# srun -n 1 -c 24 ./$EXECUTABLE >> ${OUTPUT}

# To compile the omp_hello.c code with GNU
gcc -O2 -fopenmp omp_hello.c -o hello_omp_gnu


# To submit the job to Kaya
jobid=$(sbatch --parsable hello_omp_gnu.slurm)
printf '\n'
printf "%s\n" "The sbatch command returns what the jobid is for this job."
printf "%s\n" "To check the status of your job, use the slurm command:"
printf "%s\n" "squeue -u $USER"
printf ' \n'
printf "%s\n" "Your job will be run in $MYSCRATCH/run_helloOmp_gnuC/${jobid}."
printf ' \n'
printf "%s\n" "Your results will be saved in ${MYGROUP}/helloOmp_gnuC_results/${jobid}"
printf "%s\n" "and the scratch directory will then be deleted."
printf ' \n'
printf "%s\n" "To check the results change to your jobid directory, type:"
printf "%s\n" "cd ${MYGROUP}/helloOmp_gnuC_results/${jobid}"
printf ' \n'
printf "%s\n" "To view the results, use the cat command and type:"
printf "%s\n" "cat helloOmp_gnuC.log"
printf ' \n'
printf "%s\n" " Kaya user shortcuts! "
printf '%s %s\n' '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
printf '%s %s\n' '$MYGROUP' "is an environment variable it is set to $MYGROUP"
printf "%s\n" " example:  cd \$MYGROUP "

printf ' \n'
printf "%s\n" "more information about Kaya can be found at:"
printf "%s\n" " https://docs.hpc.uwa.edu.au/docs"
printf ' \n'
printf "%s\n" "more information about SLURM and srun can be found at:"
printf "%s\n" " https://docs.hpc.uwa.edu.au/docs/slurm"
printf ' \n'
printf ' \n'
