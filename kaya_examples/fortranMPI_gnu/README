#!/bin/bash --login
# This is the README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate hello_mpi.f90 example 
# in GNU environment on Kaya.
# hello_mpi.f90 code is taken from
# https://people.sc.fsu.edu/~jburkardt/f_src/hello_mpi/hello_mpi.f90
# cp the hello_mpi.f90 source code
cp $GE_DIR/src/hello_mpi.f90 .

# hello_mpi.f90 is an MPI code that runs on 2 nodes 
# with 10 MPI tasks on each node (20 MPI tasks total).
# To run this code, we need to specify the total number of MPI tasks
# and the number of MPI tasks per node.
# This information is located under hello_mpi_gnu.slurm
# You can edit the SLURM as: emacs hello_mpi_gnu.slurm &

# SLURM directives
# 
# Here we specify to SLURM we want 2 nodes (--nodes=2)
# To compile hello_mpi.f90 with GNU:
module load gcc/14.3 openmpi/5.0.5
# To launch a job, we specify to srun 20 MPI tasks (-n 20)
# across 2 nodes (-N 2)
# Therefore, the srun command looks like:
# srun -N 2 -n 20 ./$EXECUTABLE >> ${OUTPUT}

# To compile the hello_mpi.f90 code with GNU compiler
mpif90 -O2 hello_mpi.f90 -o hello_mpi_gnu

# To submit the job to Kaya
jobid=$(sbatch --parsable hello_mpi_gnu.slurm)
printf '\n'
printf "%s\n" "The sbatch command returns what the jobid is for this job."
printf "%s\n" "To check the status of your job, use the slurm command:"
printf "%s\n" "squeue -u $USER"
printf "%s\n" " "
printf "%s\n" "Your job will be run in $MYSCRATCH/run_fortranMPI_gnu/${jobid}."
printf "%s\n" " "
printf "%s\n" "Your results will be saved in ${MYGROUP}/fortranMPI_gnu_results/${jobid}"
printf "%s\n" "and the scratch directory will then be deleted."
printf "%s\n" " "
printf "%s\n" "To check the results change to your jobid directory, type:"
printf "%s\n" "cd ${MYGROUP}/fortranMPI_gnu_results/${jobid}"
printf "%s\n" " "
printf "%s\n" "To view the results, use the cat command and type:"
printf "%s\n" "cat fortranMPI_gnu.log"
printf "%s\n" " "
printf "%s\n" " Kaya user shortcuts! "
printf "%s %s\n" '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
printf "%s %s\n" '$MYGROUP' "is an environment variable it is set to $MYGROUP"
printf "%s\n" " example:  cd \$MYGROUP "

printf "%s\n" " "
printf "%s\n" "more information about Kaya can be found at:"
printf "%s\n" " https://docs.hpc.uwa.edu.au/docs"
printf "%s\n" " "
printf "%s\n" "more information about SLURM and srun can be found at:"
printf "%s\n" " https://docs.hpc.uwa.edu.au/docs/slurm"
printf "%s\n" " "
printf "%s\n" " "
