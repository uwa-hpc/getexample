#!/bin/bash --login
# This README file is an executable script.
# To run: ./README
#
# Example OBJECTIVE: demonstrate the SWASH OpenMP example
# on KAYA using the Intel compiler toolchain.
#
# Copy the SWASH example input files:
cp $GE_DIR/src/swash/a11* .

# SWASH is a general-purpose numerical tool for simulating
# unsteady, non-hydrostatic, free-surface, rotational flow
# and transport phenomena in coastal waters.

# This example uses OpenMP threads on a single node.
# The number of threads is configured in swash.slurm.
# You can edit the SLURM script using:
# code swash.slurm

# Load Intel compiler and SWASH modules:
module load intel/2020.4 swash/9.01

# Submit the job to KAYA:
jobid=$(sbatch --parsable swash.slurm)

printf "%s\n" "The sbatch command returns the job ID."
printf "%s\n" "To check the job status, use:"
printf "%s\n" "squeue -u $USER"
printf '\n'
printf "%s\n" "Your job will run in $MYSCRATCH/run_swash/${jobid}."
printf '\n'
printf "%s\n" "Your results will be saved in:"
printf "%s\n" "${MYGROUP}/swash_results_a11stwav/${jobid}"
printf "%s\n" "The scratch directory will then be deleted."
printf '\n'
printf "%s\n" "To check the results, change to your job directory:"
printf "%s\n" "cd ${MYGROUP}/swash_results_a11stwav/${jobid}"
printf '\n'
printf "%s\n" "To view the results, use:"
printf "%s\n" "cat a11stw01.prt"
printf '\n'
printf "%s\n" "KAYA user shortcuts:"
printf '%s %s\n' '$MYSCRATCH' "is set to $MYSCRATCH"
printf '%s %s\n' '$MYGROUP' "is set to $MYGROUP"
printf '\n'
printf "%s\n" "More information about KAYA:"
printf "%s\n" "https://docs.hpc.uwa.edu.au/docs/"
printf '\n'
printf "%s\n" "More information about SLURM:"
printf "%s\n" "https://docs.hpc.uwa.edu.au/docs/slurm/"