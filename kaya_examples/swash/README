#!/bin/bash --login
# This README file is an executable script.
# To run: ./README
#
# Example OBJECTIVE: demonstrate the SWASH OpenMP example
# on KAYA using the Intel compiler toolchain.
#
# Copy the SWASH example input files:
cp $GE_DIR/src/swash/a11* .

# SWASH is a general-purpose numerical tool for simulating
# unsteady, non-hydrostatic, free-surface, rotational flow
# and transport phenomena in coastal waters.

# This example uses OpenMP threads on a single node.
# The number of threads is configured in swash.slurm.
# You can edit the SLURM script using:
# code swash.slurm

# Load Intel compiler and SWASH modules:
module load intel/2020.4 swash/9.01

# Submit the job to KAYA:
jobid=$(sbatch --parsable swash.slurm)

echo "The sbatch command returns the job ID."
echo "To check the job status, use:"
echo "squeue -u $USER"
echo " "
echo "Your job will run in $MYSCRATCH/run_swash/${jobid}."
echo " "
echo "Your results will be saved in:"
echo "${MYGROUP}/swash_results_a11stwav/${jobid}"
echo "The scratch directory will then be deleted."
echo " "
echo "To check the results, change to your job directory:"
echo "cd ${MYGROUP}/swash_results_a11stwav/${jobid}"
echo " "
echo "To view the results, use:"
echo "cat a11stw01.prt"
echo " "
echo "KAYA user shortcuts:"
echo '$MYSCRATCH' "is set to $MYSCRATCH"
echo '$MYGROUP' "is set to $MYGROUP"
echo " "
echo "More information about KAYA:"
echo "https://docs.hpc.uwa.edu.au/docs/"
echo " "
echo "More information about SLURM:"
echo "https://docs.hpc.uwa.edu.au/docs/slurm/"