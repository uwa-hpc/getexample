#!/bin/bash --login
# This is the README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate OpenMP thread placement
# on Kaya using the Intel compiler and Slurm CPU binding.
#
# Copy the omp_hello.c source code
cp $GE_DIR/src/omp_hello.c .

# This example uses 1 node, 1 task and 12 CPUs per task.
# OpenMP creates 12 threads.
# Intel OpenMP affinity controls thread placement, while
# Slurm binds the task to its allocated CPU cores.
#
# This information is configured in hello_numa_intel.slurm.

# Load the Intel oneAPI compiler environment
module use /uwahpc/rocky9/modulefiles/intel/2023.0
module load compiler

# Compile the OpenMP C program
icx -O2 -qopenmp omp_hello.c -o hello_numa_intel

# To submit the job to Kaya
jobid=$(sbatch --parsable hello_numa_intel.slurm)

echo ""
echo "The sbatch command returns the job ID."
echo "To check the status of your job, use:"
echo "squeue -u $USER"
echo ""
echo "Your job will run in:"
echo "$MYSCRATCH/run_hello_NUMA_intel/${jobid}"
echo ""
echo "Your results will be saved in:"
echo "${MYGROUP}/hello_NUMA_intel_results/${jobid}"
echo "The scratch directory will then be deleted."
echo ""
echo "To check the results, change to your job directory:"
echo "cd ${MYGROUP}/hello_NUMA_intel_results/${jobid}"
echo ""
echo "To view the results:"
echo "cat hello_NUMA_intel.log"
echo ""
echo "Kaya user shortcuts:"
echo '$MYSCRATCH' "is set to $MYSCRATCH"
echo '$MYGROUP' "is set to $MYGROUP"
echo ""
echo "More information about Kaya:"
echo "https://docs.hpc.uwa.edu.au/docs"
echo ""
echo "More information about Slurm:"
echo "https://docs.hpc.uwa.edu.au/docs/slurm"
echo ""
