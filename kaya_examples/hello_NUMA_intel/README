#!/bin/bash --login
# This is the README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate OpenMP thread placement
# on Kaya using the Intel compiler and Slurm CPU binding.
#
# Copy the omp_hello.c source code
cp $GE_DIR/src/omp_hello.c .

# This example uses 1 node, 1 task and 12 CPUs per task.
# OpenMP creates 12 threads.
# Intel OpenMP affinity controls thread placement, while
# Slurm binds the task to its allocated CPU cores.
#
# This information is configured in hello_numa_intel.slurm.

# Load the Intel oneAPI compiler environment
module use /uwahpc/rocky9/modulefiles/intel/2023.0
module load compiler

# Compile the OpenMP C program
icx -O2 -qopenmp omp_hello.c -o hello_numa_intel

# To submit the job to Kaya
jobid=$(sbatch --parsable hello_numa_intel.slurm)

printf '\n'
printf '%s\n' "The sbatch command returns the job ID."
printf '%s\n' "To check the status of your job, use:"
printf '%s\n' "squeue -u $USER"
printf '\n'
printf '%s\n' "Your job will run in:"
printf '%s\n' "$MYSCRATCH/run_hello_NUMA_intel/${jobid}"
printf '\n'
printf '%s\n' "Your results will be saved in:"
printf '%s\n' "${MYGROUP}/hello_NUMA_intel_results/${jobid}"
printf '%s\n' "The scratch directory will then be deleted."
printf '\n'
printf '%s\n' "To check the results, change to your job directory:"
printf '%s\n' "cd ${MYGROUP}/hello_NUMA_intel_results/${jobid}"
printf '\n'
printf '%s\n' "To view the results:"
printf '%s\n' "cat hello_NUMA_intel.log"
printf '\n'
printf '%s\n' "Kaya user shortcuts:"
printf '%s %s\n' '$MYSCRATCH' "is set to $MYSCRATCH"
printf '%s %s\n' '$MYGROUP' "is set to $MYGROUP"
printf '\n'
printf '%s\n' "More information about Kaya:"
printf '%s\n' "https://docs.hpc.uwa.edu.au/docs"
printf '\n'
printf '%s\n' "More information about Slurm:"
printf '%s\n' "https://docs.hpc.uwa.edu.au/docs/slurm"
printf '\n'
