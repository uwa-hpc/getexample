#!/bin/bash --login
# This README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate ORCA example on Kaya
# 
# The input file used is water.inp, taken from:
# https://faccts.de
# Copy the input file water.inp to user's directory.
cp $GE_DIR/src/orca/water.inp .

# ORCA is an MPI code that can run across multiple nodes.
# This is a simple example and needs 16 cores (MPI tasks),
# matching "%pal nprocs 16 end" inside water.inp.

# ORCA uses a specific OpenMPI library loaded automatically
# by the ORCA module once the compiler module is loaded.

# This information can be found in run_orca.slurm
# You can edit the SLURM script with nano: nano run_orca.slurm

# SLURM directives
# Here we specify in the SLURM script that we want 1 node (--nodes=1)
# and 16 MPI tasks (--ntasks=16).
# Load the GNU compiler and ORCA module:
module load gcc/14.3.0 orca/6.0.0

# To submit the job to Kaya
jobid=$(sbatch --parsable run_orca.slurm)

echo "The sbatch command returns what the jobid is for this job."
echo "To check the status of your job, use the slurm command:"
echo "squeue -u $USER"
echo " "
echo "Your job will be run in $MYSCRATCH/run_orca/${jobid}."
echo " "
echo "Your results will be saved in ${MYGROUP}/orca_results/${jobid}"
echo "and the scratch directory will then be deleted."
echo " "
echo "To check the results change to your jobid directory, type:"
echo "cd ${MYGROUP}/orca_results/${jobid}"
echo " " 
echo "To view the results, use the cat command and type:"
echo "cat orca_water.out"
echo " "
echo " Kaya user shortcuts! " 
echo  '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
echo  '$MYGROUP' "is an environment variable it is set to $MYGROUP"
echo " example:  cd \$MYGROUP "

echo " "  
echo "more information about Kaya can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs"
echo " "
echo "more information about SLURM and srun can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs/slurm"
echo " "
echo " "
