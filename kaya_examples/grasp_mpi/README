
#!/bin/bash --login

# This README file is an executable script.
# To run type: ./README

# Example OBJECTIVE: demonstrate the GRASP case1_mpi example
# on Kaya using the GNU environment.

# Copy the GRASP testcase directory to the current directory.
cp -r "$GE_DIR/src/grasp" . || exit 1

# The General Relativistic Atomic Structure Package (GRASP)
# is a set of Fortran 90 programs for performing fully
# relativistic electron structure calculations of atoms.

# This example uses 34 MPI tasks on one node.
# The resource allocation is specified in grasp_mpi.slurm.

# Load the GNU compiler, OpenMPI and LAPACK modules.
module load gcc/14.3.0 openmpi/5.0.5 lapack/3.12.1

# The calculation scripts obtain the MPI process count
# from the SLURM allocation through SLURM_NTASKS.

# Submit the job to Kaya and capture the job ID.
jobid=$(sbatch --parsable grasp_mpi.slurm) || exit 1

printf "%s\n" "The job has been submitted."
printf "%s\n" "Job ID: ${jobid}"
printf "%s\n" "To check the job status, use:"
printf "%s\n" "squeue -u $USER"
printf "%s\n" " "

printf "%s\n" "Your job will run in:"
printf "%s\n" "$MYSCRATCH/run_grasp/${jobid}"
printf "%s\n" " "

printf "%s\n" "Your results will be saved in:"
printf "%s\n" "${MYGROUP}/grasp_results/${jobid}"
printf "%s\n" "The scratch directory will be deleted after the job finishes."
printf "%s\n" " "

printf "%s\n" "To check the results, change to your job directory:"
printf "%s\n" "cd ${MYGROUP}/grasp_results/${jobid}"
printf "%s\n" " "

printf "%s\n" "To view the output log, use:"
printf "%s\n" "cat case1_mpi.log"
printf "%s\n" " "

printf "%s\n" "Kaya user shortcuts:"
printf '%s is set to %s\n' '$MYSCRATCH' "$MYSCRATCH"
printf '%s is set to %s\n' '$MYGROUP' "$MYGROUP"
printf '%s\n' 'Example: cd $MYGROUP'
printf "%s\n" " "

printf "%s\n" "More information about Kaya:"
printf "%s\n" "https://docs.hpc.uwa.edu.au/docs"
printf "%s\n" " "

printf "%s\n" "More information about SLURM:"
printf "%s\n" "https://docs.hpc.uwa.edu.au/docs/slurm"
printf "%s\n" " "
