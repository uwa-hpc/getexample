#!/bin/bash --login
# This is the README file is an executable script.
# To run type: ./README
#
# Example OBJECTIVE: to demonstrate hello_mpi.f90 example on 
# Kaya with GNU environment across two partially occupied nodes.
# hello_mpi.f90 is an MPI code which runs on 2 nodes
# with 12 MPI tasks on each node (6 per socket).

# Copy the hello_mpi.f90 source code
cp $GE_DIR/src/hello_mpi.f90 .

# To run this code, we specify the total number of MPI tasks,
# the number of MPI tasks per node, and the number of MPI tasks per socket.
# This information is located under hellompi_partial_gnu.slurm
# You can edit the SLURM script as: nano hellompi_partial_gnu.slurm

# SLURM directives (set in hellompi_partial_gnu.slurm):
# Here we specify to SLURM we want 2 nodes (--nodes=2),
# 24 MPI tasks (--ntasks=24), 12 MPI tasks per node (--ntasks-per-node=12),
# and 6 MPI tasks per socket (--ntasks-per-socket=6).
# Load the GNU and OpenMPI toolchain:
module load gcc/14.3.0 openmpi/5.0.5

# Inside hellompi_partial_gnu.slurm, MPI tasks are launched with mpirun:
# mpirun -np $SLURM_NTASKS --map-by ppr:6:package ./$EXECUTABLE >> ${OUTPUT}

# To compile the hello_mpi.f90 code with GNU
mpif90 -O2 hello_mpi.f90 -o hellompi_partial_gnu

# To submit the job to Kaya
jobid=$(sbatch --parsable hellompi_partial_gnu.slurm)
echo ""
echo "The sbatch command returns what the jobid is for this job."
echo "To check the status of your job, use the slurm command:"
echo "squeue -u $USER"
echo " "
echo "Your job will be run in $MYSCRATCH/run_partially_occupied_nodes_gnu/${jobid}."
echo " "
echo "Your results will be saved in ${MYGROUP}/partially_occupied_nodes_gnu_results/${jobid}"
echo "and the scratch directory will then be deleted."
echo " "
echo "To check the results change to your jobid directory, type:"
echo "cd ${MYGROUP}/partially_occupied_nodes_gnu_results/${jobid}"
echo " " 
echo "To view the results, use the cat command and type:"
echo "cat partially_occupied_nodes_gnu.log"
echo " "
echo " Kaya user shortcuts! " 
echo  '$MYSCRATCH' "is an environment variable it is set to $MYSCRATCH"
echo  '$MYGROUP' "is an environment variable it is set to $MYGROUP"
echo " example:  cd \$MYGROUP "

echo " "  
echo "more information about Kaya can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs"
echo " "
echo "more information about SLURM and srun can be found at:"
echo " https://docs.hpc.uwa.edu.au/docs/slurm"
echo " "
echo " "
